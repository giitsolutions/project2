# OPENROUTESERVICE_API_KEY=
# GOOGLE_MAPS_API_KEY=
# TOLLGURU_API_KEY=
# Set to "true" to use Google Routes API (requires GOOGLE_MAPS_API_KEY)
GOOGLE_ROUTES_ENABLED=true
# Set to "true" to use TollGuru real FASTag toll data (requires TOLLGURU_API_KEY)
TOLLGURU_ENABLED=true
# Set to "true" to use Google Geocoding API (requires GOOGLE_MAPS_API_KEY)
GOOGLE_GEOCODE_ENABLED=true

# Authentication and saved trips (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Random string of at least 32 characters used to sign login sessions
# Generate one with: openssl rand -base64 48
AUTH_SECRET=
